# Set these environment variables for the Tomcat process, then restart Tomcat.
# This file is a template and is NOT loaded automatically.
VNPAY_ENVIRONMENT=sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://your-domain.example/Pharma_Flow/payment/vnpay/return
# Optional: VNPAYQR opens VNPAY's QR flow; blank lets the customer choose.
VNPAY_BANK_CODE=VNPAYQR
# Register https://your-domain.example/Pharma_Flow/payment/vnpay/ipn with VNPAY.
