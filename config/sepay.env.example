# Set on the Tomcat process; this example is NOT loaded automatically.
# Use the HMAC-SHA256 secret from your SePay LIVE webhook, at least 32 characters.
SEPAY_WEBHOOK_SECRET=
# The main receiving account must match accountNumber in bank notifications.
SEPAY_ACCOUNT_NUMBER=
# Optional official VA; used for the QR and matched against webhook subAccount.
# Keep SEPAY_ACCOUNT_NUMBER as the MAIN bank account, not the VA.
SEPAY_VA_ACCOUNT=
SEPAY_ACCOUNT_NAME=
SEPAY_BANK_CODE=MB
SEPAY_GATEWAY=MBBank
# POST https://your-domain.example/Pharma_Flow/payment/sepay/webhook
# Set the SePay dashboard content type to application/json (verified live).
# Authentication: HMAC-SHA256; transfer direction: money in.
